# Copy to .env and fill in. Never commit .env (it is git-ignored).

# ---------------------------------------------------------------- runtime
POLL_INTERVAL_SECONDS=600          # 10 min between cycles in daemon mode
INITIAL_LOOKBACK_HOURS=6           # first run only: ignore posts older than this
MAX_PUBLISH_ATTEMPTS=5             # per platform, per post
MAX_VIDEO_BYTES=1073741824         # 1 GB download cap
MAX_VIDEO_SECONDS=600            # clips only: skip anything >= this (a full episode is 25-30 min)
TEMP_DIR=./temp
DB_PATH=./data/state.sqlite3
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------------------------- X (source)
# Option A: app-only bearer token (X API Basic tier or higher; Free tier cannot read timelines)
X_BEARER_TOKEN=
# Option B: OAuth 2.0 user context (auto-refreshed; rotated refresh token stored in DB)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
X_MAX_RESULTS=20
# Option C: no X API — logged-in x.com session cookies (browser export, e.g. Cookie-Editor
# JSON). Same format as X_COOKIES_JSON used by fetch_and_push.py. Needs playwright + chromium.
X_COOKIES_FILE=
# X_COOKIES_JSON=[...]
# Option D: no X API — an RSS feed per handle (self-hosted RSSHub/Nitter) + yt-dlp
# X_RSS_URL_TEMPLATE=https://rsshub.example.com/twitter/user/{handle}
X_USE_YTDLP_FALLBACK=true          # use yt-dlp if direct MP4 download fails

# ---------------------------------------------------------------- Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=                # from @BotFather; add the bot as channel admin
TELEGRAM_CHANNEL_ID=               # @channelusername or -100xxxxxxxxxx
TELEGRAM_API_BASE=https://api.telegram.org   # local telegram-bot-api server lifts 50 MB cap

# ---------------------------------------------------------------- Instagram (Meta Graph API)
INSTAGRAM_ENABLED=true
INSTAGRAM_USER_ID=                 # IG professional account id
INSTAGRAM_ACCESS_TOKEN=            # long-lived (60 d); auto-renewed by the app
# graph.instagram.com = Instagram Login (no Facebook Page needed, renews without app secret)
# graph.facebook.com  = Facebook Login (account linked to a Page; set META_APP_ID/SECRET to auto-renew)
INSTAGRAM_GRAPH_HOST=graph.instagram.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
INSTAGRAM_SHARE_TO_FEED=true

# ---------------------------------------------------------------- LinkedIn
LINKEDIN_ENABLED=true
LINKEDIN_ACCESS_TOKEN=             # personal profile: scope w_member_social (60 days, not renewable)
LINKEDIN_AUTHOR_URN=               # urn:li:person:XXXX
LINKEDIN_TOKEN_EXPIRES_AT=         # YYYY-MM-DD shown when the token was created → expiry warnings
LINKEDIN_API_VERSION=202409        # YYYYMM; bump within LinkedIn's supported window

# ---------------------------------------------------------------- Alerts
ALERT_TELEGRAM_CHAT_ID=            # your own chat id: python -m alerts.notifier whoami
ALERT_REPEAT_HOURS=12              # re-alert a persisting problem at most this often
ALERT_EXPIRY_DAYS=7                # warn this many days before a token/login expires
HEALTHCHECK_URL=                   # e.g. https://hc-ping.com/<uuid>; alerts if the Mac stops checking
STALE_GAP_HOURS=3

# ---------------------------------------------------------------- Rednote / Xiaohongshu
REDNOTE_ENABLED=false
REDNOTE_MODE=playwright            # playwright | webhook
REDNOTE_COOKIES_FILE=./config/rednote_cookies.json
REDNOTE_HEADLESS=true
REDNOTE_WEBHOOK_URL=
REDNOTE_WEBHOOK_TOKEN=
